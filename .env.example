DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_hostinger_database_name
# One private list, shared by everyone who knows this password (12+ characters).
SHARED_PASSWORD=replace-with-a-long-private-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters
# Full public HTTPS URL, no trailing slash. Local example below.
APP_ORIGIN=http://localhost:5187
# Optional additional full origins, comma-separated (e.g. your local network URL).
# Production origins must all use HTTPS. Never use a wildcard.
APP_ALLOWED_ORIGINS=
NODE_ENV=development
PORT=5187
